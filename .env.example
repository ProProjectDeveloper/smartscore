# Supabase project URL and anon key — safe to expose to the browser.
# Project settings -> Data API, and Project settings -> API keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only key. It bypasses Row Level Security, so it must never be
# exposed to the browser or committed. Used only to run the public
# assessment-taking flow (reading questions without leaking the answer key,
# and writing scored submissions).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Absolute base URL, used to build shareable assessment links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
